# OpenAI API Key for AI features (conversation, summaries, Whisper STT, TTS)
# Get it from: https://platform.openai.com/api-keys
# This single key is used for all OpenAI features: GPT-4o-mini, Whisper, and TTS
OPENAI_API_KEY=your_openai_api_key_here

# Maximum number of questions AI will ask during conversation
MAX_QUESTIONS=8

# Estimated minutes per person in queue
ESTIMATED_MINUTES_PER_PERSON=4

# Base wait time (in minutes) before queue processing starts
BASE_WAIT_TIME=8
